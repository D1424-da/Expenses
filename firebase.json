{
  "hosting": {
    "public": "static",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.js"
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/blog/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "/blog.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=600"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/login.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/admin.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://esm.sh https://www.googletagmanager.com https://www.google-analytics.com https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.googleapis.com https://www.gstatic.com wss://*.firebaseio.com https://receipt-ocr-ejrl.onrender.com https://esm.sh https://media.githubusercontent.com https://raw.githubusercontent.com https://api.stripe.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.googletagmanager.com https://i.moshimo.com https://m.media-amazon.com https://images-fe.ssl-images-amazon.com https://thumbnail.image.rakuten.co.jp https://hbb.afl.rakuten.co.jp https://item-shopping.c.yimg.jp https://*.r10s.jp; worker-src 'self' blob:; frame-src https://expenses-9af61.firebaseapp.com https://get-tohon.online https://js.stripe.com https://accounts.google.com; manifest-src 'self'; frame-ancestors 'none';"
          }
        ]
      }
    ],
